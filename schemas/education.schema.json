{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scottjarmusch.github.io/metabolomics-navigator/schemas/education.schema.json",
  "title": "Metabolomics Navigator education resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "summary",
    "url",
    "resource_type",
    "tool_slugs",
    "provider",
    "validation_status",
    "status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 220
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "resource_type": {
      "enum": [
        "video",
        "workshop",
        "tutorial",
        "documentation",
        "training_hub"
      ]
    },
    "tool_slugs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "provider": {
      "type": "string",
      "minLength": 2,
      "maxLength": 180
    },
    "experience_level": {
      "enum": [
        "introductory",
        "intermediate",
        "advanced",
        "mixed",
        "unspecified"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "note": {
      "type": "string",
      "maxLength": 700
    },
    "validation_status": {
      "enum": [
        "unreviewed",
        "validated",
        "rejected"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submitted_by": {
          "enum": [
            "curator",
            "developer",
            "maintainer",
            "user",
            "other"
          ]
        },
        "last_checked": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        }
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "year_kind": {
      "enum": [
        "published",
        "event",
        "updated"
      ]
    },
    "date_source": {
      "type": "string",
      "format": "uri"
    },
    "date_verified_at": {
      "type": "string",
      "format": "date"
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    }
  },
  "dependentRequired": {
    "year": [
      "year_kind",
      "date_source",
      "date_verified_at"
    ],
    "year_kind": [
      "year"
    ],
    "date_source": [
      "year"
    ],
    "date_verified_at": [
      "year"
    ]
  }
}
